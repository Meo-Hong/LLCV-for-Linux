#: src/ui/SettingsScreen.cpp
msgid "Auto (highest uncompressed rate)"
msgstr "Automático (maior taxa sem compressão)"

#: src/ui/SettingsScreen.cpp
msgid "30 fps · direct request"
msgstr "30 fps · solicitação direta"

#: src/ui/SettingsScreen.cpp
msgid ""
"Direct request: 30 fps. This is not a support confirmation. Start stops with "
"a notice if the driver rejects it or applies another rate; check Actual FPS "

#: src/app/App.cpp
msgid "The previous recording is still being finalized."
msgstr "A gravação anterior ainda está sendo finalizada."

#: src/app/App.cpp
msgid ""
"This build has no recording support. Rebuild LLCV with the FFmpeg "
"development files installed."
msgstr ""
"Esta compilação não tem suporte a gravação. Instale os arquivos de "
"desenvolvimento do FFmpeg e compile o LLCV novamente."

#: src/app/App.cpp
msgid "This input format cannot be recorded."
msgstr "Este formato de entrada não pode ser gravado."

#: src/app/App.cpp
msgid "HDR input cannot be recorded. Recording supports SDR video only."
msgstr ""
"A entrada HDR não pode ser gravada. A gravação suporta somente vídeo SDR."

#: src/app/App.cpp
msgid "The recording folder is unavailable."
msgstr "A pasta de gravações não está disponível."

#: src/app/App.cpp
msgid "Not enough free space in the recording folder."
msgstr "Não há espaço livre suficiente na pasta de gravações."

#: src/app/App.cpp
msgid "Recording stopped: not enough disk space."
msgstr "Gravação interrompida: não há espaço suficiente em disco."

#: src/app/App.cpp
msgid "Recording stopped: the file could not be written."
msgstr "Gravação interrompida: não foi possível gravar o arquivo."

#: src/app/App.cpp
msgid ""
"Recording stopped: encoding or writing could not keep up. Lower the "
"recording resolution or frame limit."
msgstr ""
"Gravação interrompida: a codificação ou a gravação em disco não acompanhou. "
"Reduza o limite de resolução ou de quadros da gravação."

#: src/app/App.cpp
msgid "Recording stopped: the encoder reported an error."
msgstr "Gravação interrompida: o codificador informou um erro."

#: src/app/App.cpp
msgid "The recording file could not be finalized."
msgstr "Não foi possível finalizar o arquivo de gravação."

#: src/app/App.cpp
msgid "Recording could not be completed."
msgstr "Não foi possível concluir a gravação."

#: src/app/App.cpp
msgid ""
"Audio device disconnected · it is restored automatically when it returns"
msgstr ""
"O dispositivo de áudio foi desconectado · ele será restaurado "
"automaticamente quando for reconectado"


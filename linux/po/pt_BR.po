#: src/ui/SettingsScreen.cpp
msgid "No capture device found. Check the USB connection and select Refresh."
msgstr ""
"Nenhum dispositivo de captura encontrado. Verifique a conexão USB e clique "
"em Atualizar."

#: src/ui/SettingsScreen.cpp
msgid "The selected device is not connected."
msgstr "O dispositivo selecionado não está conectado."

#: src/ui/SettingsScreen.cpp

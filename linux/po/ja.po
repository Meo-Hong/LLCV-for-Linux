msgstr "オーディオあり"

#: src/app/App.cpp
msgid "The device does not support the selected mode."
msgstr "選択したモードにデバイスが対応していません。"

#: src/app/App.cpp
msgid "No capture device was found. Check the USB connection."
msgstr "キャプチャデバイスが見つかりませんでした。USB接続を確認してください。"

#: src/app/App.cpp
#, c-format
msgid "HDR input not supported: %s"
msgstr "HDR入力非対応：%s"


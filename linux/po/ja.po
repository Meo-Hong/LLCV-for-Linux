msgstr "オーディオ専用 · %s"

#: src/app/App.cpp
msgid "Select a capture audio device."
msgstr "キャプチャオーディオデバイスを選択してください。"

#: src/app/App.cpp
msgid "No capture device."
msgstr "キャプチャデバイスがありません。"


msgid "Display"
msgstr "표시"

#: src/app/App.cpp
msgid "Immediate"
msgstr "저지연"

#: src/app/App.cpp src/ui/SettingsScreen.cpp
msgid "Sharp"
msgstr "선명하게"

#: src/app/App.cpp src/ui/SettingsScreen.cpp
msgid "Smooth"
msgstr "부드럽게"

#: src/app/App.cpp
msgid "Actual FPS"
msgstr "실제 FPS"

#: src/app/App.cpp
#, c-format
msgid "Input %.1f · Present %.1f"
msgstr "입력 %.1f · 표시 %.1f"

#: src/app/App.cpp
msgid "App latency"
msgstr "앱 처리 지연"

#: src/app/App.cpp
#, c-format
msgid "capture→present %s · copy/decode %s (not total HDMI latency)"
msgstr "수신→표시 %s · 복사/디코드 %s (총 HDMI 지연 아님)"

#: src/app/App.cpp
msgid "Frames"
msgstr "프레임"

#: src/app/App.cpp
#, c-format
msgid "Input %llu · Presented %llu · Replaced %llu"
msgstr "입력 %llu · 표시 %llu · 최신화 건너뜀 %llu"

#: src/app/App.cpp
#, c-format
msgid "HDR10 input · HDR10 passthrough (%d-bit buffer)"
msgstr "입력 HDR10 · HDR10 패스스루 (%d비트 버퍼)"

#: src/app/App.cpp
#, c-format
msgid "HDR10 input · SDR tone mapping (%d nit white)"
msgstr "입력 HDR10 · SDR 톤매핑 (기준 흰색 %d nit)"

#: src/app/App.cpp
msgid "SDR input"
msgstr "SDR 입력"

#: src/app/App.cpp
msgid " · HDR output not supported"
msgstr " · HDR 출력 미지원"

#: src/app/App.cpp
msgid " · HDR input not supported"
msgstr " · HDR 입력 미지원"

#: src/app/App.cpp
msgid " · display HDR"
msgstr " · 모니터 HDR"

#: src/app/App.cpp
msgid " · display SDR"
msgstr " · 모니터 SDR"

#: src/app/App.cpp
msgid "Frame loss"
msgstr "프레임 손실"

#: src/app/App.cpp
#, c-format
msgid "Driver dropped %llu · corrupt %llu · %d buffers"
msgstr "드라이버 누락 %llu · 손상 %llu · 버퍼 %d개"


msgstr "LLCV está reproduciendo la captura."

#: src/app/App.cpp
msgid "Capture device disconnected"
msgstr "Dispositivo de captura desconectado"

#: src/app/App.cpp
msgid "Playback resumes automatically when the device reconnects."
msgstr ""
"La reproducción se reanuda automáticamente cuando el dispositivo se vuelve a "
"conectar."

#: src/app/App.cpp
msgid "Waiting for signal"
msgstr "Esperando señal"

#: src/app/App.cpp
msgid "Check the HDMI source and the capture device. HDR output must be off."
msgstr ""
"Revisa la fuente HDMI y el dispositivo de captura. La salida HDR debe estar "
"desactivada."


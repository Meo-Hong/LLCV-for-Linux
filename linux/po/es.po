#: src/ui/SettingsScreen.cpp
msgid "No capture device found. Check the USB connection and select Refresh."
msgstr ""
"No se encontró ningún dispositivo de captura. Revisa la conexión USB y "
"selecciona Actualizar."

#: src/ui/SettingsScreen.cpp
msgid "The selected device is not connected."
msgstr "El dispositivo seleccionado no está conectado."

#: src/ui/SettingsScreen.cpp
msgid "Capture resolution"
msgstr "Resolución de captura"

#: src/ui/SettingsScreen.cpp

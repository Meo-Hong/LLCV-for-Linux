msgstr "Automático (recomendado · corrige solo cuando hace falta)"

#: src/ui/SettingsScreen.cpp
msgid "Off (unaltered PCM · quality first)"
msgstr "Desactivado (PCM sin alterar · prioridad a la calidad)"

#: src/ui/SettingsScreen.cpp
msgid "If sound breaks up occasionally, raise the PCM target in 5 ms steps."
msgstr ""
"Si el sonido se corta de vez en cuando, sube el objetivo PCM en pasos de 5 "
"ms."

#: src/ui/SettingsScreen.cpp
msgid "Playback & convenience"
msgstr "Reproducción y comodidad"

#: src/ui/SettingsScreen.cpp

#: src/app/App.cpp
msgid "The previous recording is still being finalized."
msgstr "La grabación anterior todavía se está finalizando."

#: src/app/App.cpp
msgid ""
"This build has no recording support. Rebuild LLCV with the FFmpeg "
"development files installed."
msgstr ""
"Esta compilación no admite grabación. Instala los archivos de desarrollo de "
"FFmpeg y vuelve a compilar LLCV."

#: src/app/App.cpp
msgid "This input format cannot be recorded."
msgstr "Este formato de entrada no se puede grabar."

#: src/app/App.cpp
msgid "HDR input cannot be recorded. Recording supports SDR video only."
msgstr "La entrada HDR no se puede grabar. La grabación solo admite video SDR."

#: src/app/App.cpp
msgid "The recording folder is unavailable."
msgstr "La carpeta de grabaciones no está disponible."

#: src/app/App.cpp
msgid "Not enough free space in the recording folder."
msgstr "No hay suficiente espacio libre en la carpeta de grabaciones."

#: src/app/App.cpp
msgid "Recording stopped: not enough disk space."
msgstr "Grabación detenida: no hay suficiente espacio en disco."

#: src/app/App.cpp
msgid "Recording stopped: the file could not be written."
msgstr "Grabación detenida: no se pudo escribir el archivo."

#: src/app/App.cpp
msgid ""
"Recording stopped: encoding or writing could not keep up. Lower the "
"recording resolution or frame limit."
msgstr ""
"Grabación detenida: la codificación o la escritura no pudo seguir el ritmo. "
"Baja el límite de resolución o de fotogramas de la grabación."

#: src/app/App.cpp
msgid "Recording stopped: the encoder reported an error."
msgstr "Grabación detenida: el codificador informó un error."

#: src/app/App.cpp
msgid "The recording file could not be finalized."
msgstr "No se pudo finalizar el archivo de grabación."

#: src/app/App.cpp
msgid "Recording could not be completed."
msgstr "No se pudo completar la grabación."

#: src/app/App.cpp
msgid ""
"Audio device disconnected · it is restored automatically when it returns"
msgstr ""
"Se desconectó el dispositivo de audio · se restablecerá automáticamente al "
"volver a conectarse"

#: src/app/App.cpp
#, c-format
msgid "The folder dialog is unavailable: %s"
msgstr "El cuadro de diálogo de carpetas no está disponible: %s"

#: src/app/App.cpp
msgid "Audio restored."
msgstr "Se restableció el audio."

#: src/app/App.cpp
